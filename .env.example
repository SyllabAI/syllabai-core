# ── SyllabAI core: environment variables ──────────────────────────────────
# Copy to .env (git-ignored) or export in your shell. NEVER commit real secrets.

# Database (Neon connection string in production; docker-compose locally)
SYLLABAI_DATABASE_URL=jdbc:postgresql://localhost:5432/syllabai
SYLLABAI_DATABASE_USERNAME=syllabai
SYLLABAI_DATABASE_PASSWORD=syllabai

# Security — REQUIRED (min 32 bytes). Generate: openssl rand -base64 48
SYLLABAI_JWT_SECRET=

# CORS: comma-separated frontend origins
SYLLABAI_CORS_ORIGINS=http://localhost:3000,https://syllabai.vercel.app

# ── Free-tier LLM chain (§26.1): all optional — app boots without keys ────
# Groq (primary): https://console.groq.com/keys
SYLLABAI_GROQ_API_KEY=
# Google Gemini (fallback): https://aistudio.google.com/apikey
SYLLABAI_GEMINI_API_KEY=
# OpenRouter (tertiary): https://openrouter.ai/keys
SYLLABAI_OPENROUTER_API_KEY=

# Embeddings (T-013, Gemini): optional — non-blank key is the provider switch
SYLLABAI_EMBEDDING_GEMINI_API_KEY=

# ── Object storage (T-007): local by default; R2 keys when enabled ────────
SYLLABAI_STORAGE_TYPE=local
SYLLABAI_R2_ACCOUNT_ID=
SYLLABAI_R2_ACCESS_KEY_ID=
SYLLABAI_R2_SECRET_ACCESS_KEY=
SYLLABAI_R2_BUCKET=syllabai
